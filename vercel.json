{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "buildCommand": "VITE_VERCEL_DEPLOYMENT=true pnpm build",
      "outputDirectory": "packages/web/dist"
    },
    "mcp": {
      "root": "packages/mcp-server",
      "framework": "express",
      "entrypoint": "dist/start.js",
      "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
      "buildCommand": "cd ../.. && pnpm mcp:build"
    },
    "ui": {
      "root": "packages/ui",
      "framework": "vite",
      "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
      "buildCommand": "cd ../.. && pnpm build:core && pnpm build:ui",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": {
        "service": "mcp"
      }
    },
    {
      "source": "/mcp/(.*)",
      "destination": {
        "service": "mcp"
      }
    },
    {
      "source": "/healthz",
      "destination": {
        "service": "mcp"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ],
  "github": {
    "silent": true
  },
  "git": {
    "deploymentEnabled": {
      "main": true,
      "master": true
    }
  }
}
